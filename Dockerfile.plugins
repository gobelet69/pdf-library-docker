FROM node:22-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PDF_RENDERER_UID=1000 \
    PDF_RENDERER_GID=1000 \
    PDF_RENDERER_SANDBOX=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN mkdir -p /ms-playwright \
    && npm ci --omit=dev \
    && npx playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

COPY pdf_browser/requirements.txt /tmp/plugin-requirements.txt
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r /tmp/plugin-requirements.txt

COPY discord_ingest_bot.py ./discord_ingest_bot.py
COPY pdf_browser/plugin_registry.py pdf_browser/plugin_store.py pdf_browser/plugin_runner.py pdf_browser/url_policy.js pdf_browser/url_to_pdf.js ./pdf_browser/

CMD ["/opt/venv/bin/python", "-u", "pdf_browser/plugin_runner.py"]
